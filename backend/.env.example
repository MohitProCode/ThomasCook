# Copy this file to .env and fill in your private values.
# Local dev defaults below; production values are set as env vars on the host.
NUITEE_ENABLED=true
NUITEE_API_KEY=replace_with_your_nuitee_api_key
NUITEE_BASE_URL=https://api.liteapi.travel
NUITEE_GUEST_NATIONALITY=IN
INVENTORY_PURGE_NON_NUITEE=true

# PORT wins when set (Render injects PORT=10000); otherwise SERVER_PORT applies.
SERVER_PORT=8082
DB_HOST=localhost
DB_PORT=3307
DB_NAME=hotel_booking
DB_USER=hotel
DB_PASSWORD=hotel
# Used only by docker-compose.prod.yml (VM path): MySQL root password + host port.
MYSQL_ROOT_PASSWORD=change-me-root-password
HOST_PORT=8082
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
# Public frontend URL used in password-reset links.
FRONTEND_URL=http://localhost:5173

# REQUIRED in production: random string, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-value-for-local-dev-only
JWT_TTL_MINUTES=60

# Optional: SMTP for password-reset emails. Leave empty to disable mail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@thomascook.example
